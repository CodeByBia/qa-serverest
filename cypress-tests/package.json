{
  "name": "qa-serverest",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
"scripts": {
  "api:start": "serverest --nodoc --timeout 600",
  "api:doc": "serverest --timeout 600",
  "cy:api": "cypress run --config-file cypress.api.config.js --expose grepTags=-@bug-aberto",
  "cy:api:smoke": "cypress run --config-file cypress.api.config.js --expose grepTags=@smoke,grepOmitFiltered=true",
  "cy:api:bugs": "cypress run --config-file cypress.api.config.js --expose grepTags=@bug-aberto,grepOmitFiltered=true --reporter-options reportDir=cypress/reports/api-bugs",
  "cy:open:api": "cypress open --config-file cypress.api.config.js",
  "test:api": "start-server-and-test api:start http://localhost:3000/usuarios cy:api",
  "test:api:smoke": "start-server-and-test api:start http://localhost:3000/usuarios cy:api:smoke",
  "test:api:bugs": "start-server-and-test api:start http://localhost:3000/usuarios cy:api:bugs"
},
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "28.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "2.2.8",
    "@cypress/grep": "7.0.0",
    "ajv": "8.20.0",
    "cypress": "16.2.1",
    "cypress-mochawesome-reporter": "5.0.0",
    "esbuild": "0.28.2",
    "serverest": "3.2.2",
    "start-server-and-test": "3.0.13"
  }
}
