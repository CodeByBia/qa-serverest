{
  "name": "playwright-tests",
  "version": "1.0.0",
  "description": "Projeto complementar Playwright do portfólio QA ServeRest: API local e E2E no front público",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e-chromium --project=e2e-firefox",
    "test:trace": "playwright test --trace on",
    "report": "playwright show-report"
  },
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5"
  }
}
